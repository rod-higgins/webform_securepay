<?php

/**
 * @file
 * Install, update and uninstall functions for webform_securepay.
 */

use Drupal\Core\Url;
use Drupal\webform_securepay\Service\ConfigurationService;

/**
 * Implements hook_install().
 */
function webform_securepay_install(): void {
  $config = \Drupal::configFactory()->getEditable(ConfigurationService::CONFIG_NAME);
  
  // Set default configuration values
  $config->set('environment', ConfigurationService::ENVIRONMENT_SANDBOX)
         ->set('currency', ConfigurationService::CURRENCY_AUD)
         ->set('dcc_enabled', FALSE)
         ->set('three_ds_enabled', FALSE)
         ->save();

  \Drupal::messenger()->addMessage(t('SecurePay module installed successfully. <a href="@url">Configure settings</a> to start accepting payments.', [
    '@url' => Url::fromRoute('webform_securepay.admin_settings')->toString(),
  ]));
}

/**
 * Implements hook_uninstall().
 */
function webform_securepay_uninstall(): void {
  // Remove configuration
  \Drupal::configFactory()->getEditable(ConfigurationService::CONFIG_NAME)->delete();
  
  // Clean up any remaining state
  $state = \Drupal::state();
  $state->delete('webform_securepay.last_connection_test');
  $state->delete('webform_securepay.api_cache');
  
  // Clear caches
  drupal_flush_all_caches();
}

/**
 * Implements hook_schema().
 */
function webform_securepay_schema(): array {
  $schema['webform_securepay_transactions'] = [
    'description' => 'SecurePay transaction logs for audit and reconciliation',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary key: unique transaction log ID.',
      ],
      'order_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'Unique order identifier from payment request.',
      ],
      'transaction_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'description' => 'SecurePay transaction ID from successful payments.',
      ],
      'amount' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Payment amount in cents (e.g., 1000 = $10.00).',
      ],
      'currency' => [
        'type' => 'varchar',
        'length' => 3,
        'not null' => TRUE,
        'default' => 'AUD',
        'description' => 'Currency code (ISO 4217 format).',
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'description' => 'Transaction status (success, failed, pending, etc.).',
      ],
      'ip_address' => [
        'type' => 'varchar',
        'length' => 45,
        'not null' => FALSE,
        'description' => 'Client IP address (supports both IPv4 and IPv6).',
      ],
      'created' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Unix timestamp when transaction was created.',
      ],
      'response_data' => [
        'type' => 'text',
        'not null' => FALSE,
        'size' => 'big',
        'description' => 'Raw API response data (JSON) for debugging and reconciliation.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'order_id' => ['order_id'],
    ],
    'indexes' => [
      'transaction_id' => ['transaction_id'],
      'status' => ['status'],
      'created' => ['created'],
      'currency' => ['currency'],
      'ip_status' => ['ip_address', 'status'],
      'amount_currency' => ['amount', 'currency'],
      'created_status' => ['created', 'status'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_requirements().
 */
function webform_securepay_requirements($phase): array {
  $requirements = [];

  if ($phase === 'runtime') {
    $config = \Drupal::config(ConfigurationService::CONFIG_NAME);
    $configService = \Drupal::service('webform_securepay.configuration');
    
    // Check basic configuration
    if (!$configService->isConfigured()) {
      $requirements['webform_securepay_config'] = [
        'title' => t('SecurePay Configuration'),
        'value' => t('Not configured'),
        'severity' => REQUIREMENT_WARNING,
        'description' => t('SecurePay is not fully configured. <a href="@url">Configure settings</a> to enable payment processing.', [
          '@url' => Url::fromRoute('webform_securepay.admin_settings')->toString(),
        ]),
      ];
    } else {
      $environment = $config->get('environment');
      $requirements['webform_securepay_config'] = [
        'title' => t('SecurePay Configuration'),
        'value' => t('Configured (@env)', [
          '@env' => $environment === ConfigurationService::ENVIRONMENT_LIVE ? 'Live' : 'Sandbox',
        ]),
        'severity' => REQUIREMENT_OK,
        'description' => t('SecurePay is properly configured and ready to process payments.'),
      ];
    }

    // Check HTTPS for live environment
    if ($config->get('environment') === ConfigurationService::ENVIRONMENT_LIVE) {
      $request = \Drupal::request();
      if (!$request->isSecure()) {
        $requirements['webform_securepay_ssl'] = [
          'title' => t('SecurePay SSL/HTTPS'),
          'value' => t('HTTPS required'),
          'severity' => REQUIREMENT_ERROR,
          'description' => t('HTTPS is required when using SecurePay in live environment. Please enable SSL/HTTPS for this site.'),
        ];
      } else {
        $requirements['webform_securepay_ssl'] = [
          'title' => t('SecurePay SSL/HTTPS'),
          'value' => t('HTTPS enabled'),
          'severity' => REQUIREMENT_OK,
          'description' => t('SSL/HTTPS is properly configured for live environment.'),
        ];
      }
    }

    // Check PHP extensions
    $requiredExtensions = ['json', 'curl', 'openssl'];
    $missingExtensions = [];
    
    foreach ($requiredExtensions as $extension) {
      if (!extension_loaded($extension)) {
        $missingExtensions[] = $extension;
      }
    }
    
    if (!empty($missingExtensions)) {
      $requirements['webform_securepay_extensions'] = [
        'title' => t('SecurePay PHP Extensions'),
        'value' => t('Missing extensions'),
        'severity' => REQUIREMENT_ERROR,
        'description' => t('Required PHP extensions are missing: @extensions. Please install these extensions.', [
          '@extensions' => implode(', ', $missingExtensions),
        ]),
      ];
    } else {
      $requirements['webform_securepay_extensions'] = [
        'title' => t('SecurePay PHP Extensions'),
        'value' => t('All required extensions available'),
        'severity' => REQUIREMENT_OK,
      ];
    }

    // Check database table
    $database = \Drupal::database();
    if (!$database->schema()->tableExists('webform_securepay_transactions')) {
      $requirements['webform_securepay_table'] = [
        'title' => t('SecurePay Database'),
        'value' => t('Table missing'),
        'severity' => REQUIREMENT_ERROR,
        'description' => t('The webform_securepay_transactions table is missing. Try reinstalling the module or run database updates.'),
      ];
    } else {
      // Check table structure
      $schema = drupal_get_module_schema('webform_securepay', 'webform_securepay_transactions');
      $tableSchema = $database->schema();
      $missingIndexes = [];
      
      if (isset($schema['indexes'])) {
        foreach ($schema['indexes'] as $indexName => $indexFields) {
          if (!$tableSchema->indexExists('webform_securepay_transactions', $indexName)) {
            $missingIndexes[] = $indexName;
          }
        }
      }
      
      if (!empty($missingIndexes)) {
        $requirements['webform_securepay_table'] = [
          'title' => t('SecurePay Database'),
          'value' => t('Missing indexes'),
          'severity' => REQUIREMENT_WARNING,
          'description' => t('Database table exists but some indexes are missing: @indexes. Run database updates to improve performance.', [
            '@indexes' => implode(', ', $missingIndexes),
          ]),
        ];
      } else {
        $requirements['webform_securepay_table'] = [
          'title' => t('SecurePay Database'),
          'value' => t('Table configured correctly'),
          'severity' => REQUIREMENT_OK,
        ];
      }
    }

    // Check connection to SecurePay (if configured)
    if ($configService->isConfigured()) {
      $lastTest = \Drupal::state()->get('webform_securepay.last_connection_test');
      
      if ($lastTest && isset($lastTest['timestamp'])) {
        $testAge = time() - $lastTest['timestamp'];
        $testAgeHours = round($testAge / 3600, 1);
        
        if ($lastTest['success']) {
          $severity = $testAge > 86400 ? REQUIREMENT_WARNING : REQUIREMENT_OK; // 24 hours
          $requirements['webform_securepay_connection'] = [
            'title' => t('SecurePay Connection'),
            'value' => t('Last test: @age hours ago (Success)', ['@age' => $testAgeHours]),
            'severity' => $severity,
            'description' => $severity === REQUIREMENT_WARNING 
              ? t('Connection test is old. <a href="@url">Test connection</a> to verify current status.', [
                  '@url' => Url::fromRoute('webform_securepay.admin_settings')->toString(),
                ])
              : t('Connection to SecurePay is working properly.'),
          ];
        } else {
          $requirements['webform_securepay_connection'] = [
            'title' => t('SecurePay Connection'),
            'value' => t('Last test: @age hours ago (Failed)', ['@age' => $testAgeHours]),
            'severity' => REQUIREMENT_ERROR,
            'description' => t('Connection to SecurePay failed. <a href="@url">Check configuration and test connection</a>.', [
              '@url' => Url::fromRoute('webform_securepay.admin_settings')->toString(),
            ]),
          ];
        }
      } else {
        $requirements['webform_securepay_connection'] = [
          'title' => t('SecurePay Connection'),
          'value' => t('Not tested'),
          'severity' => REQUIREMENT_WARNING,
          'description' => t('Connection to SecurePay has not been tested. <a href="@url">Test connection</a> to verify configuration.', [
            '@url' => Url::fromRoute('webform_securepay.admin_settings')->toString(),
          ]),
        ];
      }
    }
  }

  return $requirements;
}