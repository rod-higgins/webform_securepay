<?php

/**
 * @file
 * Install, update and uninstall functions for the webform_securepay module.
 */

use Drupal\Core\Database\Database;

/**
 * Implements hook_install().
 */
function webform_securepay_install() {
  // Set default configuration values for the modern SecurePay API
  $config = \Drupal::configFactory()->getEditable('webform_securepay.settings');
  
  // Authentication Settings (OAuth 2.0)
  $config->set('client_id', '');
  $config->set('client_secret', '');
  $config->set('merchant_code', '');
  $config->set('environment', 'sandbox');
  
  // Legacy settings (maintain backward compatibility)
  $config->set('api_url', 'https://api.securepay.com.au/xmlapi/payment');
  $config->set('test_mode', TRUE);
  
  // Payment Settings
  $config->set('currency', 'AUD');
  $config->set('default_mode', 'checkout');
  $config->set('order_id_prefix', 'WF_');
  $config->set('timeout', 30);
  
  // Card Settings
  $config->set('allowed_card_types', ['visa', 'mastercard', 'amex', 'diners']);
  $config->set('show_card_icons', TRUE);
  
  // UI Style Settings
  $config->set('background_color', 'rgba(255, 255, 255, 0.1)');
  $config->set('label_font_family', 'Arial, Helvetica, sans-serif');
  $config->set('label_font_size', '1rem');
  $config->set('label_color', '#333');
  $config->set('input_font_family', 'Arial, Helvetica, sans-serif');
  $config->set('input_font_size', '1rem');
  $config->set('input_color', '#333');
  
  // Feature Flags
  $config->set('dcc_enabled', FALSE);
  $config->set('three_ds_enabled', FALSE);
  $config->set('fraud_guard_enabled', FALSE);
  $config->set('auto_focus', FALSE);
  $config->set('bin_check_enabled', FALSE);
  
  // Advanced Settings
  $config->set('log_transactions', FALSE);
  $config->set('debug_mode', FALSE);
  
  // Fraud Settings
  $config->set('fraud_check_type', '');
  $config->set('fraud_score_threshold', 75);
  
  // Notification Settings
  $config->set('success_message', 'Payment processed successfully.');
  $config->set('error_message', 'Payment processing failed. Please try again.');
  $config->set('processing_message', 'Processing your payment...');
  $config->set('email_notifications', FALSE);
  $config->set('notification_email', '');
  
  // Webhook Settings
  $config->set('webhook_enabled', FALSE);
  $config->set('webhook_secret', '');
  
  // Security Settings
  $config->set('pci_compliance_mode', TRUE);
  $config->set('data_retention_days', 90);
  
  // Apple Pay Settings (for future expansion)
  $config->set('apple_pay_enabled', FALSE);
  $config->set('apple_pay_merchant_id', '');
  $config->set('apple_pay_domains', []);
  
  // PayPal Settings (for future expansion)
  $config->set('paypal_enabled', FALSE);
  $config->set('paypal_client_id', '');
  
  // Analytics Settings
  $config->set('analytics_enabled', FALSE);
  $config->set('google_analytics_id', '');
  
  // Rate Limiting
  $config->set('rate_limit_enabled', TRUE);
  $config->set('max_attempts_per_hour', 50);
  
  // Multi-language Support
  $config->set('language_support', FALSE);
  $config->set('default_language', 'en');
  
  // Custom CSS and JavaScript
  $config->set('custom_css', '');
  $config->set('custom_javascript', '');
  
  $config->save();

  // Create database tables for transaction logging if needed
  _webform_securepay_create_tables();

  // Display installation message
  \Drupal::messenger()->addMessage(t('SecurePay module has been installed. Configure your settings at <a href="@url">SecurePay Settings</a>.', [
    '@url' => \Drupal::url('webform_securepay.admin_settings'),
  ]));
}

/**
 * Implements hook_uninstall().
 */
function webform_securepay_uninstall() {
  // Clean up configuration
  \Drupal::configFactory()->getEditable('webform_securepay.settings')->delete();
  
  // Drop custom tables
  $schema = Database::getConnection()->schema();
  
  if ($schema->tableExists('webform_securepay_transactions')) {
    $schema->dropTable('webform_securepay_transactions');
  }
  
  if ($schema->tableExists('webform_securepay_refunds')) {
    $schema->dropTable('webform_securepay_refunds');
  }
  
  if ($schema->tableExists('webform_securepay_webhooks')) {
    $schema->dropTable('webform_securepay_webhooks');
  }
  
  // Clear cache
  drupal_flush_all_caches();
}

/**
 * Implements hook_schema().
