/**
 * Create database tables.
 */
function _webform_securepay_create_tables() {
  $schema = webform_securepay_schema();
  $database = Database::getConnection();
  
  foreach ($schema as $table_name => $table_schema) {
    if (!$database->schema()->tableExists($table_name)) {
      $database->schema()->createTable($table_name, $table_schema);
    }
  }
}

/**
 * Update 8001: Migrate from legacy XML API to modern REST API.
 */
function webform_securepay_update_8001() {
  $config = \Drupal::configFactory()->getEditable('webform_securepay.settings');
  
  // Migrate old settings to new format
  $old_merchant_id = $config->get('merchant_id');
  $old_password = $config->get('password');
  
  if ($old_merchant_id) {
    // For migration, use the old merchant_id as merchant_code
    $config->set('merchant_code', $old_merchant_id);
    
    // Clear old legacy settings or keep for backward compatibility
    // $config->clear('merchant_id');
    // $config->clear('password');
  }
  
  // Add new OAuth 2.0 settings
  if (!$config->get('client_id')) {
    $config->set('client_id', '');
  }
  if (!$config->get('client_secret')) {
    $config->set('client_secret', '');
  }
  if (!$config->get('environment')) {
    $config->set('environment', 'sandbox');
  }
  
  // Add new feature flags
  $config->set('dcc_enabled', FALSE);
  $config->set('three_ds_enabled', FALSE);
  $config->set('fraud_guard_enabled', FALSE);
  
  $config->save();
  
  return t('Migrated SecurePay configuration to modern REST API format.');
}

/**
 * Update 8002: Add new configuration options.
 */
function webform_securepay_update_8002() {
  $config = \Drupal::configFactory()->getEditable('webform_securepay.settings');
  
  // Add card type settings
  if (!$config->get('allowed_card_types')) {
    $config->set('allowed_card_types', ['visa', 'mastercard', 'amex', 'diners']);
  }
  
  // Add UI style settings
  $style_defaults = [
    'background_color' => 'rgba(255, 255, 255, 0.1)',
    'label_font_family' => 'Arial, Helvetica, sans-serif',
    'label_font_size' => '1rem',
    'label_color' => '#333',
    'input_font_family' => 'Arial, Helvetica, sans-serif',
    'input_font_size' => '1rem',
    'input_color' => '#333',
  ];
  
  foreach ($style_defaults as $key => $value) {
    if (!$config->get($key)) {
      $config->set($key, $value);
    }
  }
  
  $config->save();
  
  return t('Added new UI customization options.');
}

/**
 * Update 8003: Create transaction logging tables.
 */
function webform_securepay_update_8003() {
  _webform_securepay_create_tables();
  
  return t('Created transaction logging tables.');
}

