        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary Key: Unique webhook ID.',
      ],
      'event_type' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'description' => 'Webhook event type.',
      ],
      'order_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'description' => 'Related order ID.',
      ],
      'payload' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => TRUE,
        'description' => 'Webhook payload data.',
      ],
      'signature' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'description' => 'Webhook signature.',
      ],
      'ip_address' => [
        'type' => 'varchar',
        'length' => 45,
        'not null' => FALSE,
        'description' => 'Source IP address.',
      ],
      'processed' => [
        'type' => 'int',
        'size' => 'tiny',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Whether webhook was processed successfully.',
      ],
      'error_message' => [
        'type' => 'text',
        'not null' => FALSE,
        'description' => 'Error message if processing failed.',
