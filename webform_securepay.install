  // Transaction logging table
  $schema['webform_securepay_transactions'] = [
    'description' => 'Stores SecurePay transaction data',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary Key: Unique transaction ID.',
      ],
      'order_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
        'description' => 'SecurePay order ID.',
      ],
      'transaction_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'description' => 'SecurePay transaction ID.',
      ],
      'webform_id' => [
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
        'description' => 'Webform ID.',
      ],
      'submission_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
        'description' => 'Webform submission ID.',
      ],
      'amount' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Transaction amount in cents.',
      ],
      'currency' => [
        'type' => 'varchar',
        'length' => 3,
        'not null' => TRUE,
        'default' => 'AUD',
        'description' => 'Transaction currency.',
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
        'description' => 'Transaction status.',
      ],
      'gateway_response_code' => [
        'type' => 'varchar',
        'length' => 16,
        'not null' => FALSE,
        'description' => 'Gateway response code.',
      ],
      'gateway_response_message' => [
        'type' => 'text',
        'not null' => FALSE,
        'description' => 'Gateway response message.',
      ],
      'ip_address' => [
        'type' => 'varchar',
        'length' => 45,
        'not null' => FALSE,
        'description' => 'Client IP address.',
      ],
      'user_agent' => [
        'type' => 'text',
        'not null' => FALSE,
        'description' => 'Client user agent.',
      ],
      'fraud_score' => [
        'type' => 'int',
        'not null' => FALSE,
        'description' => 'Fraud check score.',
      ],
      'three_ds_result' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => FALSE,
        'description' => '3DS2 authentication result.',
      ],
      'raw_response' => [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'Raw API response data.',
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp when transaction was created.',
      ],
      'updated' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
        'description' => 'Timestamp when transaction was last updated.',
      ],
    ],
    'primary key' => ['id'],
    'unique keys' => [
      'order_id' => ['order_id'],
    ],
    'indexes' => [
      'webform_id' => ['webform_id'],
      'submission_id' => ['submission_id'],
      'status' => ['status'],
      'created' => ['created'],
      'amount' => ['amount'],
    ],
  ];

  // Refunds table
  $schema['webform_securepay_refunds'] = [
    'description' => 'Stores SecurePay refund data',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Primary Key: Unique refund ID.',
      ],
      'transaction_id' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Reference to original transaction.',
      ],
      'refund_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
        'description' => 'SecurePay refund ID.',
      ],
      'amount' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'description' => 'Refund amount in cents.',
      ],
      'reason' => [
        'type' => 'text',
        'not null' => FALSE,
        'description' => 'Reason for refund.',
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 32,
