<?php

/**
 * @file
 * Install, update and uninstall functions for webform_securepay.
 */

/**
 * Implements hook_install().
 */
function webform_securepay_install() {
  $config = \Drupal::configFactory()->getEditable('webform_securepay.settings');
  
  $config->set('environment', 'sandbox')
         ->set('currency', 'AUD')
         ->set('dcc_enabled', FALSE)
         ->set('three_ds_enabled', FALSE)
         ->save();

  \Drupal::messenger()->addMessage(t('SecurePay module installed. <a href="@url">Configure settings</a>.', [
    '@url' => \Drupal::url('webform_securepay.admin_settings'),
  ]));
}

/**
 * Implements hook_uninstall().
 */
function webform_securepay_uninstall() {
  \Drupal::configFactory()->getEditable('webform_securepay.settings')->delete();
}

/**
 * Implements hook_schema().
 */
function webform_securepay_schema() {
  $schema['webform_securepay_transactions'] = [
    'description' => 'SecurePay transaction logs',
    'fields' => [
      'id' => [
        'type' => 'serial',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'order_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => TRUE,
      ],
      'transaction_id' => [
        'type' => 'varchar',
        'length' => 255,
        'not null' => FALSE,
      ],
      'amount' => [
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
      ],
      'currency' => [
        'type' => 'varchar',
        'length' => 3,
        'not null' => TRUE,
        'default' => 'AUD',
      ],
      'status' => [
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ],
      'ip_address' => [
        'type' => 'varchar',
        'length' => 45,
        'not null' => FALSE,
      ],
      'created' => [
        'type' => 'int',
        'not null' => TRUE,
        'default' => 0,
      ],
      'response_data' => [
        'type' => 'text',
        'not null' => FALSE,
      ],
    ],
    'primary key' => ['id'],
    'indexes' => [
      'order_id' => ['order_id'],
      'status' => ['status'],
      'created' => ['created'],
    ],
  ];

  return $schema;
}

/**
 * Implements hook_requirements().
 */
function webform_securepay_requirements($phase) {
  $requirements = [];

  if ($phase === 'runtime') {
    $config = \Drupal::config('webform_securepay.settings');
    
    if (empty($config->get('client_id')) || empty($config->get('merchant_code'))) {
      $requirements['webform_securepay'] = [
        'title' => t('SecurePay Configuration'),
        'value' => t('Not configured'),
        'severity' => REQUIREMENT_WARNING,
        'description' => t('<a href="@url">Configure SecurePay settings</a>.', [
          '@url' => \Drupal::url('webform_securepay.admin_settings'),
        ]),
      ];
    } else {
      $requirements['webform_securepay'] = [
        'title' => t('SecurePay Configuration'),
        'value' => t('Configured'),
        'severity' => REQUIREMENT_OK,
      ];
    }
  }

  return $requirements;
}