{#
/**
 * @file
 * Simplified SecurePay webform element template.
 *
 * Available variables:
 * - element: The element array.
 * - value: The element value.
 * - options: The element options.
 */
#}

{%
  set classes = [
    'webform-securepay-element',
    element.environment == 'sandbox' ? 'sandbox-mode' : 'live-mode',
    element.dcc_enabled ? 'dcc-enabled',
    element.three_ds_enabled ? 'three-ds-enabled',
  ]
%}

<div{{ attributes.addClass(classes) }}>
  
  {# Element header with title and badges #}
  {% if element.title %}
    {% include '@webform_securepay/securepay-header.html.twig' with {
      title: element.title,
      environment: element.environment,
      features: {
        three_ds: element.three_ds_enabled,
        fraud_guard: element.fraud_guard_enabled
      }
    } %}
  {% endif %}
  
  {# Element description #}
  {% if element.description %}
    <div class="webform-securepay-description">
      {{ element.description }}
    </div>
  {% endif %}
  
  {# Payment amount and card acceptance display #}
  {% include '@webform_securepay/payment-info.html.twig' with {
    amount: element.amount,
    currency: element.currency,
    allowed_card_types: element.allowed_card_types,
    show_card_icons: element.show_card_icons,
    mode: element.mode
  } %}
  
  {# Main SecurePay UI container #}
  <div class="webform-securepay-payment">
    {{ element.securepay_container }}
  </div>
  
  {# DCC options (if enabled) #}
  {% if element.mode == 'dcc' %}
    {{ element.dcc_options }}
  {% endif %}
  
  {# Payment controls #}
  <div class="webform-securepay-controls">
    {{ element.payment_button }}
    {% if element.reset_button %}
      {{ element.reset_button }}
    {% endif %}
  </div>
  
  {# Loading indicator #}
  <div class="loading-indicator" style="display: none;">
    <div class="spinner"></div>
    <span class="loading-text">{{ 'Processing your payment...'|t }}</span>
  </div>
  
  {# Transaction result display #}
  {% if value.transaction_id or value.status %}
    {% include '@webform_securepay/payment-result.html.twig' with {
      result: value
    } %}
  {% else %}
    {{ element.result }}
  {% endif %}
  
  {# Footer with security badges #}
  {% include '@webform_securepay/securepay-footer.html.twig' with {
    environment: element.environment
  } %}
  
</div>

{# Custom styling and scripts #}
{% if element.custom_css %}
  <style>{{ element.custom_css|raw }}</style>
{% endif %}

{% if element.custom_javascript %}
  <script>
    (function($) {
      $(document).ready(function() {
        {{ element.custom_javascript|raw }}
      });
    })(jQuery);
  </script>
{% endif %}