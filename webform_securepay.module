/**
 * Implements hook_help().
 */
function webform_securepay_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.webform_securepay':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('The SecurePay module provides comprehensive payment integration for Drupal Webforms using the modern SecurePay REST API with OAuth 2.0 authentication.') . '</p>';
      
      $output .= '<h3>' . t('Features') . '</h3>';
      $output .= '<ul>';
      $output .= '<li>' . t('Modern SecurePay REST API integration with OAuth 2.0') . '</li>';
      $output .= '<li>' . t('Complete UI Component with all SecurePay callbacks') . '</li>';
      $output .= '<li>' . t('Dynamic Currency Conversion (DCC) support') . '</li>';
      $output .= '<li>' . t('3D Secure 2 authentication') . '</li>';
      $output .= '<li>' . t('FraudGuard and ACI ReD Shield fraud detection') . '</li>';
      $output .= '<li>' . t('Apple Pay and PayPal support (future)') . '</li>';
      $output .= '<li>' . t('Comprehensive transaction logging and reporting') . '</li>';
      $output .= '<li>' . t('Webhook support for real-time notifications') . '</li>';
      $output .= '<li>' . t('Customizable UI styling and behavior') . '</li>';
      $output .= '<li>' . t('PCI DSS compliance features') . '</li>';
      $output .= '</ul>';
      
      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('Configure the module at <a href="@url">SecurePay Settings</a>.', [
        '@url' => \Drupal::url('webform_securepay.admin_settings'),
      ]) . '</p>';
      
      $output .= '<h3>' . t('Usage') . '</h3>';
      $output .= '<ol>';
      $output .= '<li>' . t('Configure your SecurePay credentials in the settings') . '</li>';
      $output .= '<li>' . t('Create or edit a webform') . '</li>';
      $output .= '<li>' . t('Add a SecurePay element to your form') . '</li>';
      $output .= '<li>' . t('Configure payment amount and other settings') . '</li>';
      $output .= '<li>' . t('Test the integration using the connection test feature') . '</li>';
      $output .= '</ol>';
      
      $output .= '<h3>' . t('Support') . '</h3>';
      $output .= '<p>' . t('For technical support, visit the <a href="@url" target="_blank">SecurePay support portal</a>.', [
        '@url' => 'https://www.securepay.com.au/support/contact-us/',
      ]) . '</p>';
      
      return $output;
      
    case 'webform_securepay.admin_settings':
      return '<p>' . t('Configure SecurePay payment processing settings. These settings apply globally to all SecurePay webform elements unless overridden at the element level.') . '</p>';
  }
}

