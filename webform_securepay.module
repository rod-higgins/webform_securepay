<?php

/**
 * @file
 * SecurePay integration for Drupal Webforms.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function webform_securepay_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.webform_securepay':
      $output = '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('SecurePay payment integration for Drupal Webforms using OAuth 2.0.') . '</p>';
      $output .= '<h3>' . t('Configuration') . '</h3>';
      $output .= '<p>' . t('<a href="@url">Configure SecurePay settings</a>.', [
        '@url' => \Drupal::url('webform_securepay.admin_settings'),
      ]) . '</p>';
      return $output;
      
    case 'webform_securepay.admin_settings':
      return '<p>' . t('Configure SecurePay payment processing settings.') . '</p>';
  }
}

/**
 * Implements hook_theme().
 */
function webform_securepay_theme() {
  return [
    'webform_securepay_element' => [
      'variables' => [
        'element' => [],
        'value' => NULL,
      ],
      'template' => 'webform-securepay-element',
    ],
  ];
}