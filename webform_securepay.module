<?php

/**
 * @file
 * Contains the webform_securepay module hooks and functions.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\webform\WebformSubmissionInterface;

/**
 * Implements hook_help().
 */
function webform_securepay_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.webform_securepay':
      return _webform_securepay_help_page();
      
    case 'webform_securepay.admin_settings':
      return '<p>' . t('Configure SecurePay payment processing settings for Drupal Webforms.') . '</p>';
  }
}

/**
 * Implements hook_theme().
 */
function webform_securepay_theme() {
  return [
    'webform_securepay_element' => [
      'variables' => [
        'element' => [],
        'value' => NULL,
        'options' => [],
      ],
      'template' => 'webform-securepay-element',
    ],
    'webform_securepay_result' => [
      'variables' => [
        'transaction_id' => NULL,
        'amount' => NULL,
        'currency' => 'AUD',
        'status' => NULL,
        'gateway_response_code' => NULL,
        'gateway_response_message' => NULL,
        'created_at' => NULL,
      ],
      'template' => 'webform-securepay-result',
    ],
  ];
}

/**
 * Implements hook_mail().
 */
function webform_securepay_mail($key, &$message, $params) {
  switch ($key) {
    case 'payment_success':
      _webform_securepay_build_success_mail($message, $params);
      break;
      
    case 'payment_failed':
      _webform_securepay_build_failure_mail($message, $params);
      break;
  }
}

/**
 * Implements hook_webform_submission_presave().
 */
function webform_securepay_webform_submission_presave(WebformSubmissionInterface $webform_submission) {
  $webform = $webform_submission->getWebform();
  $elements = $webform->getElementsInitializedAndFlattened();
  
  foreach ($elements as $element_key => $element) {
    if (($element['#type'] ?? '') === 'securepay') {
      $payment_data = $webform_submission->getElementData($element_key);
      
      if (_webform_securepay_is_successful_payment($payment_data)) {
        _webform_securepay_log_submission_association($webform_submission, $payment_data);
        
        // Trigger payment success events
        \Drupal::moduleHandler()->invokeAll('webform_securepay_payment_success', [
          $webform_submission,
          $payment_data,
        ]);
      }
    }
  }
}

/**
 * Implements hook_cron().
 */
function webform_securepay_cron() {
  $config_service = \Drupal::service('webform_securepay.configuration');
  
  // Clean up old transaction logs
  $retention_days = $config_service->get('data_retention_days');
  if ($retention_days && $retention_days > 0) {
    _webform_securepay_cleanup_old_transactions($retention_days);
  }
}

/**
 * Implements hook_form_alter().
 */
function webform_securepay_form_alter(&$form, FormStateInterface $form_state, $form_id) {
  if (strpos($form_id, 'webform_') === 0) {
    // Add rate limiting validation
    $form['#validate'][] = '_webform_securepay_validate_rate_limit';
  }
}

/**
 * Build help page content.
 */
function _webform_securepay_help_page(): string {
  $output = '<h3>' . t('About') . '</h3>';
  $output .= '<p>' . t('The SecurePay module provides comprehensive payment integration for Drupal Webforms using the modern SecurePay REST API with OAuth 2.0 authentication.') . '</p>';
  
  $output .= '<h3>' . t('Features') . '</h3>';
  $features = [
    t('Modern SecurePay REST API integration with OAuth 2.0'),
    t('Dynamic Currency Conversion (DCC) support'),
    t('3D Secure 2 authentication'),
    t('FraudGuard fraud detection'),
    t('Comprehensive transaction logging'),
    t('Webhook support for real-time notifications'),
    t('Customizable UI styling'),
  ];
  
  $output .= '<ul><li>' . implode('</li><li>', $features) . '</li></ul>';
  
  $output .= '<h3>' . t('Configuration') . '</h3>';
  $output .= '<p>' . t('Configure the module at <a href="@url">SecurePay Settings</a>.', [
    '@url' => \Drupal::url('webform_securepay.admin_settings'),
  ]) . '</p>';
  
  return $output;
}

/**
 * Build success email message.
 */
function _webform_securepay_build_success_mail(&$message, $params): void {
  $result = $params['result'];
  
  $message['subject'] = t('Payment Successful - Transaction @id', [
    '@id' => $result['transaction_id'] ?? 'Unknown',
  ]);
  
  $message['body'][] = t('A payment has been successfully processed through SecurePay.');
  $message['body'][] = '';
  $message['body'][] = t('Transaction Details:');
  $message['body'][] = t('- Transaction ID: @id', ['@id' => $result['transaction_id'] ?? 'N/A']);
  $message['body'][] = t('- Amount: @amount @currency', [
    '@amount' => number_format(($result['amount'] ?? 0) / 100, 2),
    '@currency' => $result['currency'] ?? 'AUD',
  ]);
  $message['body'][] = t('- Status: @status', ['@status' => $result['status'] ?? 'Unknown']);
}

/**
 * Build failure email message.
 */
function _webform_securepay_build_failure_mail(&$message, $params): void {
  $result = $params['result'];
  
  $message['subject'] = t('Payment Failed - Order @id', [
    '@id' => $result['transaction_id'] ?? 'Unknown',
  ]);
  
  $message['body'][] = t('A payment attempt has failed through SecurePay.');
  $message['body'][] = '';
  $message['body'][] = t('Error Details:');
  $message['body'][] = t('- Error: @error', ['@error' => $result['error'] ?? 'Unknown error']);
  $message['body'][] = t('- Order ID: @id', ['@id' => $result['transaction_id'] ?? 'N/A']);
}

/**
 * Check if payment data represents a successful payment.
 */
function _webform_securepay_is_successful_payment($payment_data): bool {
  return !empty($payment_data) && 
         is_array($payment_data) && 
         ($payment_data['status'] ?? '') === 'paid';
}

/**
 * Log submission association with transaction.
 */
function _webform_securepay_log_submission_association(WebformSubmissionInterface $submission, array $payment_data): void {
  if (empty($payment_data['transaction_id'])) {
    return;
  }
  
  $database = \Drupal::database();
  
  try {
    $database->update('webform_securepay_transactions')
      ->fields([
        'submission_id' => $submission->id(),
        'webform_id' => $submission->getWebform()->id(),
        'updated' => \Drupal::time()->getRequestTime(),
      ])
      ->condition('order_id', $payment_data['transaction_id'])
      ->execute();
  }
  catch (\Exception $e) {
    \Drupal::logger('webform_securepay')->error('Failed to log submission association: @message', [
      '@message' => $e->getMessage(),
    ]);
  }
}

/**
 * Clean up old transaction records.
 */
function _webform_securepay_cleanup_old_transactions(int $retention_days): void {
  $cutoff = \Drupal::time()->getRequestTime() - ($retention_days * 24 * 60 * 60);
  $database = \Drupal::database();
  
  try {
    $tables = [
      'webform_securepay_transactions',
      'webform_securepay_webhooks',
    ];
    
    foreach ($tables as $table) {
      if ($database->schema()->tableExists($table)) {
        $database->delete($table)
          ->condition('created', $cutoff, '<')
          ->execute();
      }
    }
  }
  catch (\Exception $e) {
    \Drupal::logger('webform_securepay')->error('Failed to cleanup old transactions: @message', [
      '@message' => $e->getMessage(),
    ]);
  }
}

/**
 * Validate rate limiting.
 */
function _webform_securepay_validate_rate_limit(array &$form, FormStateInterface $form_state): void {
  $config_service = \Drupal::service('webform_securepay.configuration');
  
  if (!$config_service->get('rate_limit_enabled')) {
    return;
  }
  
  $max_attempts = $config_service->get('max_attempts_per_hour', 50);
  $ip_address = \Drupal::request()->getClientIp();
  
  if (_webform_securepay_check_rate_limit($ip_address, $max_attempts)) {
    $form_state->setErrorByName('', t('Too many payment attempts. Please try again later.'));
  }
}

/**
 * Check rate limiting for IP address.
 */
function _webform_securepay_check_rate_limit(string $ip_address, int $max_attempts): bool {
  $database = \Drupal::database();
  
  if (!$database->schema()->tableExists('webform_securepay_transactions')) {
    return FALSE;
  }
  
  $one_hour_ago = \Drupal::time()->getRequestTime() - 3600;
  
  try {
    $attempts = $database->select('webform_securepay_transactions', 't')
      ->condition('ip_address', $ip_address)
      ->condition('created', $one_hour_ago, '>')
      ->countQuery()
      ->execute()
      ->fetchField();
    
    return $attempts >= $max_attempts;
  }
  catch (\Exception $e) {
    \Drupal::logger('webform_securepay')->error('Rate limit check failed: @message', [
      '@message' => $e->getMessage(),
    ]);
    return FALSE;
  }
}